<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Disable default IIS WebSocket handler so Socket.io/Node.js can handle it -->
    <webSocket enabled="false" />

    <handlers>
      <!-- Tell IIS to process server.js via iisnode -->
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- 1. Serve static files directly from the public/ folder if they exist (except index.html) -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="([\S]+)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{APPL_PHYSICAL_PATH}public\{R:1}" matchType="IsFile" />
            <add input="{R:1}" pattern="^index\.html$" negate="true" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="public/{R:1}" />
        </rule>

        <!-- 2. Route all other requests to server.js (Node.js backend) -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Security: Hide backend folders and node_modules from direct web access -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="db" />
          <add segment="middleware" />
          <add segment="routes" />
          <add segment="bin" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- iisnode settings: automatically restart on file changes and log errors -->
    <iisnode 
      watchedFiles="web.config;*.js"
      loggingEnabled="true"
      devErrorsEnabled="true"
      nodeProcessCommandLine="&quot;%programfiles%\nodejs\node.exe&quot;" 
    />
  </system.webServer>
</configuration>
